# ---- Required ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/unico_homecare?retryWrites=true&w=majority
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
APP_BASE_URL=http://localhost:3000

# ---- Email (Gmail SMTP + App Password). Leave blank to log emails without sending ----
GMAIL_USER=unicoathome.office@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME="Unico Hospitals · Home Care"
DEPARTMENT_EMAIL=unicoathome.office@gmail.com

# ---- WhatsApp deep links ----
WA_DEFAULT_COUNTRY=880
HOSPITAL_PHONE=+880 9666 710 710

# ---- Scheduled jobs (Vercel Cron sends this as Bearer token) ----
CRON_SECRET=

# ---- Seed ----
SEED_ADMIN_PASSWORD=Unico@2026

# Google Maps (free tier). Browser key — restrict it in Google Cloud to HTTP referrers
# (https://unico-homecare.vercel.app/*, http://localhost:3000/*) and to these APIs:
# Maps Embed API (free, unlimited), Maps JavaScript API + Places API (New) (10,000 free calls/month each).
# Unset (default) = free OpenStreetMap pin picker + Photon address search + keyless Google embeds.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: a Map ID from Google Cloud (Map Management); defaults to DEMO_MAP_ID
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
